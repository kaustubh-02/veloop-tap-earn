# ==========================================================
# VELoop Rewards - Tap & Earn Backend - Environment Variables
# Copy this file to .env and fill in real values.
# ==========================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local by default; swap for Atlas URI in production)
MONGO_URI=mongodb://127.0.0.1:27017/veloop_tap_earn

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Rate limiting (global safety net; tap-specific limits live in DB config)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Seed script
SEED_ADMIN_EMAIL=admin@veloop.dev
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_USERS=10
